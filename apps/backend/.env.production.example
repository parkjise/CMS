# ═══════════════════════════════════════════════════════════════════════
# 운영 백엔드 환경변수 — 복사해서 apps/backend/.env.production 으로 (git 제외)
#   cp apps/backend/.env.production.example apps/backend/.env.production
# docker-compose.prod.yml 의 backend · worker · beat 가 읽는다.
# DB · Redis 접속 주소(DATABASE_URL 등)는 compose 가 루트 .env 로 만들어 덮어쓴다.
#
# APP_ENV=production 이면 아래 값 중 개발 기본값이 남아 있을 때 기동하지 않는다
# (app/core/config.py production_problems — 일부러 예외로 둘 항목은 PRODUCTION_CHECK_SKIP).
# 예시 도메인 cms.example.com 을 실제 도메인으로 바꾼다.
# ═══════════════════════════════════════════════════════════════════════

APP_ENV=production
# 32자 이상 무작위 (openssl rand -base64 48)
APP_SECRET_KEY=

ALLOWED_ORIGINS=https://cms.example.com,https://www.cms.example.com,https://admin.cms.example.com,https://system.cms.example.com
ADMIN_BASE_URL=https://admin.cms.example.com
CLIENT_BASE_URL=https://cms.example.com
# 홈페이지 ↔ 관리자 로그인 공유 — 점(.)으로 시작
COOKIE_DOMAIN=.cms.example.com

# ─── 이미지 저장소 ───────────────────────────────────────────
MINIO_BUCKET_NAME=cms-media
MINIO_USE_SSL=false
# nginx 가 /cms-media/ 를 MinIO 로 넘긴다 (CDN 을 쓰면 그 주소)
CDN_BASE_URL=https://cms.example.com/cms-media
# 샘플 이미지 업로드(scripts/upload_template_assets.py) 후 CDN_BASE_URL 과 같은 값
TEMPLATE_ASSET_BASE_URL=

# ─── 슈퍼 어드민 ─────────────────────────────────────────────
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# 사무실 IP 등 (쉼표, 비우면 제한 없음 — 권장: 지정)
SUPER_ADMIN_ALLOWED_IPS=

# ─── 알림 · 메일 · 결제 · 소셜 · 도메인 (전부 live) ─────────────
NOTIFICATION_MODE=live
KAKAO_API_KEY=
KAKAO_SENDER_KEY=
NCLOUD_SENS_SERVICE_ID=
NCLOUD_SENS_SMS_SERVICE_ID=
NCLOUD_SENS_ACCESS_KEY=
NCLOUD_SENS_SECRET_KEY=
NCLOUD_SENS_FROM_NO=

EMAIL_MODE=live
AWS_SES_REGION=ap-northeast-2
AWS_SES_FROM_EMAIL=no-reply@cms.example.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

PAYMENT_MODE=live
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=
# base64 32바이트 — 한 번 정하면 바꾸지 말 것 (바꾸면 기존 빌링키 복호화 불가)
BILLING_KEY_ENCRYPTION_KEY=

SOCIAL_MODE=live
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 카카오 · 네이버 개발자 콘솔에 같은 주소를 등록
SOCIAL_REDIRECT_URI=https://cms.example.com/member/social/callback

DOMAIN_MODE=live
DOMAIN_CNAME_TARGET=cms.example.com
NGINX_SITES_DIR=/etc/nginx/sites-enabled

# ─── reCAPTCHA v3 — 비우면 문의 폼이 검증 없이 통과 ───────────
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# ─── 관측성 ──────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# 일부러 test 로 둘 항목 (예: 결제 오픈 전 payment_mode)
PRODUCTION_CHECK_SKIP=
