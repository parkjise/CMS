# ─── 앱 기본 설정 ───────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-32-chars-min
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# 관리자 · 홈페이지 주소 (메일 · 알림 링크, CORS 자동 포함)
ADMIN_BASE_URL=http://localhost:3001
CLIENT_BASE_URL=http://localhost:3000
# 저장 직후 홈페이지(Next.js) 캐시 비우기 — apps/client/.env.local 의 REVALIDATE_SECRET 과 같은 값
# (비우면 저장 내용이 홈페이지에 최대 1분 늦게 반영)
CLIENT_INTERNAL_URL=http://localhost:3000
REVALIDATE_SECRET=
# 홈페이지 ↔ 관리자 로그인 공유 쿠키 범위 — 로컬은 비움, 운영은 ".도메인" (CLAUDE.md 7.2)
COOKIE_DOMAIN=

# ─── 데이터베이스 ────────────────────────────────────────────
# 앱 접속 계정 — 일반 권한(RLS 적용). scripts/init_db_roles.py 가 만든다
DATABASE_URL=postgresql+asyncpg://cms_app:cms_app_password@localhost:5432/cms_db
# 소유자 계정 — 마이그레이션 · 계정 생성 · 시드 전용 (앱은 쓰지 않음)
MIGRATION_DATABASE_URL=postgresql+asyncpg://cms_user:cms_password@localhost:5432/cms_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── JWT ─────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── MinIO / S3 ──────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=cms-media
MINIO_USE_SSL=false
CDN_BASE_URL=http://localhost:9000/cms-media
# 템플릿 샘플 이미지 공용 주소 — 비우면 /templates/... 상대 주소 (클라이언트 public)
# 운영: scripts/upload_template_assets.py 로 올린 뒤 CDN_BASE_URL 과 같은 값
TEMPLATE_ASSET_BASE_URL=

# ─── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── 알림톡 (카카오) · SMS (네이버 클라우드 SENS, 오픈 이슈 #21) ─────
# NOTIFICATION_MODE=test 는 실제 발송 없이 기록만 (개발 환경에선 인증번호를 응답에 포함)
NOTIFICATION_MODE=test
KAKAO_API_KEY=
KAKAO_SENDER_KEY=
NCLOUD_SENS_SERVICE_ID=
NCLOUD_SENS_SMS_SERVICE_ID=
NCLOUD_SENS_ACCESS_KEY=
NCLOUD_SENS_SECRET_KEY=
NCLOUD_SENS_FROM_NO=

# 방문자 소셜 로그인 (T-110) — test: 가짜 계정 / live: 실제 카카오 · 네이버
SOCIAL_MODE=test
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
SOCIAL_REDIRECT_URI=http://localhost:3000/member/social/callback

# ─── 슈퍼 어드민 ─────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@cms.io
SUPER_ADMIN_PASSWORD=change-me
# 슈퍼 어드민 접근 허용 IP (쉼표, 비우면 제한 없음) · 토큰 유효 시간(분)
SUPER_ADMIN_ALLOWED_IPS=
SUPER_ADMIN_TOKEN_EXPIRE_MINUTES=5

# ─── 토스페이먼츠 정기결제 (T-096) ───────────────────────────
# PAYMENT_MODE=test 는 외부 API 호출 없이 stub 응답
PAYMENT_MODE=test
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=
# 빌링키 암호화 키 (T-106, base64 32바이트). 미설정 시 APP_SECRET_KEY에서 파생.
BILLING_KEY_ENCRYPTION_KEY=

# ─── 이메일 발송 (T-098, AWS SES) ────────────────────────────
# EMAIL_MODE=test 는 SES 호출 없이 stub 응답
EMAIL_MODE=test
AWS_SES_REGION=ap-northeast-2
AWS_SES_FROM_EMAIL=no-reply@cms.io
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── 커스텀 도메인 (T-100) ───────────────────────────────────
# DOMAIN_MODE=test 는 DNS/certbot/nginx 호출 없이 stub
DOMAIN_MODE=test
DOMAIN_CNAME_TARGET=cms.example.com
NGINX_SITES_DIR=/etc/nginx/sites-enabled

# 관측성 (T-083) — 미설정 시 Sentry 비활성
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── reCAPTCHA v3 (문의 폼) — 비우면 검증 없이 통과 (운영은 필수) ──
RECAPTCHA_SECRET_KEY=

# 요청 한도 (IP 당, 기본값 그대로 권장) — E2E CI 처럼 한 IP 에서 많이 부를 때만 올린다
LOGIN_RATE_LIMIT=10/minute
INQUIRY_RATE_LIMIT=3/minute
RECAPTCHA_MIN_SCORE=0.5

# ─── 기타 ────────────────────────────────────────────────────
TRIAL_DAYS=14
SSL_RENEW_BEFORE_DAYS=30
AI_CACHE_TTL_SECONDS=3600
AI_RATE_LIMIT_PER_MINUTE=10
# 운영 안전 점검에서 일부러 건너뛸 항목 (예: payment_mode) — APP_ENV=production 에서만 의미
PRODUCTION_CHECK_SKIP=
