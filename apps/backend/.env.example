# ─── 앱 기본 설정 ───────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-32-chars-min
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ─── 데이터베이스 ────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cms_user:cms_password@localhost:5432/cms_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── JWT ─────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── MinIO / S3 ──────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=cms-media
MINIO_USE_SSL=false
CDN_BASE_URL=http://localhost:9000/cms-media

# ─── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── 알림톡 (카카오) ─────────────────────────────────────────
KAKAO_API_KEY=
KAKAO_SENDER_KEY=

# ─── 슈퍼 어드민 ─────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@cms.io
SUPER_ADMIN_PASSWORD=change-me

# ─── 토스페이먼츠 정기결제 (T-096) ───────────────────────────
# PAYMENT_MODE=test 는 외부 API 호출 없이 stub 응답
PAYMENT_MODE=test
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=
