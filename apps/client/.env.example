# 백엔드 API 기본 URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# 관리자 페이지 URL (홈페이지에서 관리자 링크 사용)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# 서비스 기본 도메인 (서브도메인 자동 제공 시)
NEXT_PUBLIC_SERVICE_BASE_DOMAIN=localhost

# CDN 호스트명 (MinIO 프로덕션)
# NEXT_PUBLIC_CDN_HOSTNAME=cdn.yourdomain.com

# reCAPTCHA v3 site key (선택)
# - 미설정 시 ContactForm은 토큰 없이 제출 (백엔드도 secret 미설정 시 통과)
# - 운영 환경에서는 반드시 설정 권장
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

