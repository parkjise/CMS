{
  "name": "cms-project",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm --filter @cms/types build && pnpm --filter @cms/ui build && pnpm --parallel --filter './apps/*' build",
    "test": "pnpm --parallel -r test",
    "lint": "pnpm --parallel -r lint",
    "type-check": "pnpm --parallel -r type-check",
    "validate": "pnpm lint && pnpm type-check && pnpm test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
